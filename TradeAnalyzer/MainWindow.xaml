<Window x:Class="TradeAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portfolio Dashboard" Height="800" Width="1300"
        Background="#0B0B0B">

    <Window.Resources>
        <!-- Stile per i box principali con bordo arrotondato -->
        <Style x:Key="RoundedCard" TargetType="Border">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ================= STILE SCROLLBAR DARK MINIMAL ================= -->

        <!-- Thumb (il cursore trascinabile) -->
        <Style x:Key="MinimalScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                        Background="#3E3E3E"
                        CornerRadius="3"
                        Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <!-- Cambio colore al passaggio del mouse -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5E5E5E"/>
                            </Trigger>
                            <!-- Cambio colore quando cliccato/trascinato -->
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#7E7E7E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Struttura della ScrollBar verticale (senza freccette sopra/sotto) -->
        <Style x:Key="MinimalScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <!-- Sfondo della barra (traccia trasparente) -->
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MinimalScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile applicato automaticamente a tutti gli ScrollViewer delle liste -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Area con il contenuto delle card -->
                            <ScrollContentPresenter Grid.Column="0" Margin="0,0,4,0"/>

                            <!-- ScrollBar verticale agganciata al controllo -->
                            <ScrollBar Grid.Column="1"
                               x:Name="PART_VerticalScrollBar"
                               Style="{StaticResource MinimalScrollBar}"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template per i singoli elementi delle 4 liste -->
        <DataTemplate x:Key="AssetItemTemplate">
            <Border Background="#1A1A1A" 
                    BorderBrush="#777777" 
                    BorderThickness="1.2" 
                    CornerRadius="10" 
                    Padding="12,10" 
                    Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Nome/Etichetta (es. UNO:) e relativo Importo -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Nome, StringFormat='{}{0}: '}" 
                                   Foreground="White" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Valore, StringFormat='{}{0:N2} €'}" 
                                   Foreground="White" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                    </StackPanel>

                    <!-- Importo già riscosso/preso -->
                    <TextBlock Text="{Binding GiaPresi, StringFormat='Già presi {0:N2} €'}" 
                               Foreground="#CCCCCC" 
                               FontSize="13" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. Riga Superiore: TOT IN, TOT OUT, NOW IN TRADE -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Barra Centrale: TOT Investiti -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Riga Inferiore: 4 Colonne Liste -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. PARTE SUPERIORE ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sinistra: TOT IN e TOT OUT -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <!-- TOT IN -->
                <Border Style="{StaticResource RoundedCard}" Margin="0,0,0,10" Padding="16,12">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="TOT IN:" Foreground="White" FontWeight="Bold" FontSize="15" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotIn, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="15" DockPanel.Dock="Right" RenderTransformOrigin="0.5,0.5" Width="300" TextAlignment="Right">
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- TOT OUT -->
                <Border Style="{StaticResource RoundedCard}" Padding="16,12">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="TOT OUT:" Foreground="White" FontWeight="Bold" FontSize="15" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotOut, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="15" DockPanel.Dock="Right" RenderTransformOrigin="0.5,0.5" Width="300" TextAlignment="Right">
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Destra: NOW IN TRADE -->
            <Border Grid.Column="1" Style="{StaticResource RoundedCard}" Margin="8,0,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="NOW IN TRADE" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding NowInTrade, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
                    <!-- Nuova voce: interessi incassati legati a CashInterestsIn -->
                    <DockPanel LastChildFill="False" Margin="0 6 0 0">
                        <TextBlock Text="Interessi incassati:"
                                   Foreground="#CCCCCC"
                                   FontSize="13"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CashInterestsIn, StringFormat='{}{0:N2} €'}"
                               Foreground="#CCCCCC"
                               FontSize="13"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 2. BARRA TOT INVESTITI ================= -->
        <Border Grid.Row="1" Style="{StaticResource RoundedCard}" Margin="0,0,0,14" Padding="18,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="TOT Investiti:" Foreground="White" FontWeight="Bold" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotInvestiti, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" RenderTransformOrigin="0.5,0.5" Width="300" TextAlignment="Right">
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ================= 3. LE 4 LISTE ================= -->
        <!-- ================= 3. LE 4 LISTE CON TOTALI IN FONDO ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Colonna 1: OBBLIGAZIONI -->
            <Border Grid.Column="0" Style="{StaticResource RoundedCard}" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titolo -->
                    <TextBlock Grid.Row="0" Text="OBBLIGAZIONI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Lista Card Scrollabile -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Obbligazioni}" ItemTemplate="{StaticResource AssetItemTemplate}"/>
                    </ScrollViewer>

                    <!-- Totali Cumulativi Fissi in Fondo -->
                    <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,8,4,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Totale:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotaleObbligazioni, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Totale presi:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotalePresiObbligazioni, StringFormat='{}{0:N2} €'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Colonna 2: AZIONI -->
            <Border Grid.Column="1" Style="{StaticResource RoundedCard}" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titolo -->
                    <TextBlock Grid.Row="0" Text="AZIONI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Lista Card Scrollabile -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Azioni}" ItemTemplate="{StaticResource AssetItemTemplate}"/>
                    </ScrollViewer>

                    <!-- Totali Cumulativi Fissi in Fondo -->
                    <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,8,4,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Totale:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotaleAzioni, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Totale presi:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotalePresiAzioni, StringFormat='{}{0:N2} €'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Colonna 3: CRYPTO -->
            <Border Grid.Column="2" Style="{StaticResource RoundedCard}" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titolo -->
                    <TextBlock Grid.Row="0" Text="CRYPTO" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Lista Card Scrollabile -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Crypto}" ItemTemplate="{StaticResource AssetItemTemplate}"/>
                    </ScrollViewer>

                    <!-- Totali Cumulativi Fissi in Fondo -->
                    <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,8,4,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Totale:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotaleCrypto, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Totale presi:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotalePresiCrypto, StringFormat='{}{0:N2} €'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Colonna 4: MERCATI PRIVATI -->
            <Border Grid.Column="3" Style="{StaticResource RoundedCard}" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titolo -->
                    <TextBlock Grid.Row="0" Text="MERCATI PRIVATI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Lista Card Scrollabile -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MercatiPrivati}" ItemTemplate="{StaticResource AssetItemTemplate}"/>
                    </ScrollViewer>

                    <!-- Totali Cumulativi Fissi in Fondo -->
                    <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,8,4,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Totale:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotaleMercatiPrivati, StringFormat='{}{0:N2} €'}" Foreground="White" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Totale presi:" Foreground="#AAAAAA" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding TotalePresiMercatiPrivati, StringFormat='{}{0:N2} €'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>